# BLACKFORGE — configuration locale. Copiez vers .env avec "make setup" (génère un mot de
# passe aléatoire à la place de __GENERATE__). Ne commitez JAMAIS le fichier .env.

# --- PostgreSQL (conteneur de développement) ---
POSTGRES_USER=blackforge
POSTGRES_PASSWORD=__GENERATE__
POSTGRES_DB=blackforge
POSTGRES_PORT=5432

# --- API (préfixe BLACKFORGE_) ---
BLACKFORGE_APP_ENV=development
BLACKFORGE_DATABASE_URL=postgresql+psycopg://blackforge:__GENERATE__@127.0.0.1:5432/blackforge
# Base dédiée aux tests d'intégration : son nom DOIT finir par _test (le schéma y est détruit).
BLACKFORGE_TEST_DATABASE_URL=postgresql+psycopg://blackforge:__GENERATE__@127.0.0.1:5432/blackforge_test
# Origines autorisées (séparées par des virgules). Jamais "*" en production.
BLACKFORGE_CORS_ORIGINS=http://localhost:3000
BLACKFORGE_LOG_LEVEL=INFO
BLACKFORGE_LOG_JSON=false
BLACKFORGE_DOCS_ENABLED=true
# Requêtes/minute/IP sur /api/*. 0 désactive la limite.
BLACKFORGE_RATE_LIMIT_PER_MINUTE=120

# --- Web ---
# Adresse de l'API vue depuis le serveur Next.js (rendu serveur + proxy de développement).
API_INTERNAL_URL=http://127.0.0.1:8000
NEXT_TELEMETRY_DISABLED=1

# Aucune clé de fournisseur d'IA ici pour l'instant : le mode démo n'en nécessite pas.
